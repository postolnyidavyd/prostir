# PostgreSQL
POSTGRES_USER=prostir
POSTGRES_PASSWORD=prostir
POSTGRES_DB=prostir
POSTGRES_PORT=5432

# Connection string для Prisma
DATABASE_URL=postgresql://prostir:prostir@localhost:5432/prostir?schema=public

# API
API_PORT=4000
NODE_ENV=development

# Origin фронтенду
WEB_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web
WEB_PORT=5173
VITE_API_URL=http://localhost:4000
